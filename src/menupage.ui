    <item>
     <widget class="QPushButton" name="StartPvPButton">
      <property name="styleSheet">
       <string notr="true">QPushButton {
    /* Diagonal gradient: red (top-left) -&gt; blue (bottom-right) */
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #D92B04, /* Strong red */
        stop: 1 #1948CE  /* Deep blue */
    );

    /* Solid black border for contrast against bright gradient */
    border: 2px solid #000000;
    border-radius: 12px;        /* Slightly more rounded corners */

    /* Text styling */
    color: #FFFFFF;             /* White text for strong contrast */
    font-family: Ubuntu;
    font-size: 26px;            /* Larger, more readable font size */
    font-weight: bold;          /* Makes text stand out */

    /* Button sizing for 1920×1080 screens */
    min-width: 220px;
    min-height: 10px;
    padding: 12px 24px;         /* Extra padding for a spacious feel */

    /* Shadow effect to add depth */
    box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.6);
}

QPushButton:hover {
    /* Slightly brighter gradient on hover for feedback */
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #FC5C2A, /* Brighter red */
        stop: 1 #2F6AF3  /* Brighter blue */
    );

    /* Outer glow effect */
    border: 2px solid #FFFFFF;  /* Changes border color for glow effect */
    box-shadow: 0px 0px 20px rgba(255, 255, 255, 0.8);
}

QPushButton:pressed {
    /* Darkened gradient when pressed */
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #A32000, /* Darker red */
        stop: 1 #0F37A5  /* Darker blue */
    );

    /* Inner shadow effect to simulate pressing */
    box-shadow: inset 4px 4px 8px rgba(0, 0, 0, 0.6);
}
</string>
      </property>
      <property name="text">
       <string>Start an Async PvP Game</string>
      </property>
     </widget>
    </item>
