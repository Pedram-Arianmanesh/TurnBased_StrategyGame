    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 #FC5C2A,
        stop: 1 #2F6AF3
    );

    box-shadow: 0 0 10px rgba(255, 255, 255, 0.7);
}
</string>
