   <property name="styleSheet">
    <string notr="true">QLabel {
    font-family: Ubuntu;
    font-size: 38px;         /* Slightly larger for better visibility */
    font-weight: bold;
    color: white;            /* White text for contrast */
    padding: 20px 30px;      /* Extra spacing for a premium look */

    /* Background: Less transparent to improve readability */
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 1,
        stop: 0 rgba(217, 43, 4, 0.9),   /* Fiery red */
        stop: 1 rgba(25, 72, 206, 0.9)   /* Icy blue */
    );

    /* Border &amp; rounded edges */
    border-radius: 12px;
    border: 2px solid rgba(0, 0, 0, 0.8); /* Slight transparency for elegance */

    /* Soft shadow for better separation from background */
    box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.7);

    /* Text alignment */
    qproperty-alignment: 'AlignCenter';
}

QLabel:hover {
    /* Glow effect on hover for subtle interaction */
    box-shadow: 0px 0px 25px rgba(255, 255, 255, 0.9);
}
</string>
   </property>
   <property name="text">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:26pt;&quot;&gt;Welcome to Strategic Battlefield!&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-size:18pt;&quot;&gt;Design your strategy, defeat rivals, and conquer the battlefield!&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
